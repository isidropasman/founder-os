# Keys — at least one provider is required. Both are required to run `pnpm eval`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where the founder's context lives. Defaults to ./context/example
FOUNDEROS_CONTEXT=./context/example

# Model per pipeline role. Format: "<provider>:<model-id>" | "claude" | "gpt".
# Defaults shown. Verify the OpenAI id against their current model list before
# running evals — provider model ids move faster than this file does.
FOUNDEROS_MODEL_ROUTER=anthropic:claude-haiku-4-5
FOUNDEROS_MODEL_REASON=anthropic:claude-opus-5
FOUNDEROS_MODEL_CHALLENGE=anthropic:claude-opus-5
FOUNDEROS_MODEL_JUDGE=anthropic:claude-opus-5

# Eval arms
FOUNDEROS_MODEL_VANILLA_CLAUDE=anthropic:claude-opus-5
FOUNDEROS_MODEL_VANILLA_GPT=openai:gpt-5
